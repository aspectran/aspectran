<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE aspectran PUBLIC "-//ASPECTRAN//DTD Aspectran 9.0//EN"
        "https://aspectran.com/dtd/aspectran-9.dtd">
<aspectran>

    <settings>
        <setting name="transletNamePrefix" value="/examples/file-upload"/>
    </settings>

    <aspect id="transletSettingsForFileUpload">
        <description>
            Specifies the environment variables used during request and response processing.
        </description>
        <joinpoint>
            methods: [
                POST
            ]
            pointcut: {
                +: /examples/file-upload/files
            }
        </joinpoint>
        <settings>
            <!-- Available parsers: standardFileUploader, commonsFileUploader, inMemoryFileUploader -->
            <setting name="multipartFormDataParser" value="standardFileUploader"/>
        </settings>
    </aspect>

    <!-- Standard Jakarta Servlet Multipart Parser (recommended) -->
    <bean id="standardFileUploader"
          class="com.aspectran.web.servlet.support.multipart.standard.StandardServletMultipartFormDataParserFactoryBean">
        <description>
            Handles multipart form data using Jakarta Servlet 3.0+ Part API.
        </description>
        <properties>
            <item name="maxRequestSize" value="10M"/>
            <item name="maxFileSize" value="5M"/>
            <item name="allowedFileExtensions" value="jpg,jpeg,png,gif"/>
        </properties>
    </bean>

    <!-- Apache Commons FileUpload Parser -->
    <bean id="commonsFileUploader"
          class="com.aspectran.web.servlet.support.multipart.commons.CommonsMultipartFormDataParserFactoryBean">
        <description>
            Handles multipart form data using Apache Commons FileUpload.
        </description>
        <properties>
            <item name="maxRequestSize" value="10M"/>
            <item name="maxFileSize" value="5M"/>
            <item name="allowedFileExtensions" value="jpg,jpeg,png,gif"/>
        </properties>
    </bean>

    <!-- In-Memory Multipart Parser -->
    <bean id="inMemoryFileUploader"
          class="com.aspectran.web.servlet.support.multipart.inmemory.InMemoryMultipartFormDataParserFactoryBean">
        <description>
            Handles multipart form data purely in memory without creating temporary files.
        </description>
        <properties>
            <item name="maxRequestSize" value="6M"/>
            <item name="maxFileSize" value="5M"/>
            <item name="allowedFileExtensions" value="jpg,jpeg,png,gif"/>
        </properties>
    </bean>

    <bean class="com.aspectran.demo.examples.upload.SimpleFileUploadActivity">
        <property name="maxFiles" valueType="int">12</property>
    </bean>

    <translet name="/">
        <echo id="page">
            <item name="headline">Uploading Files</item>
            <item name="teaser">
                This guide walks you through the process of creating a server application that can receive
                HTTP multipart file uploads.</item>
            <item name="include">examples/file-upload</item>
            <item name="style">plate</item>
            <item name="maxFiles">#{class:com.aspectran.demo.examples.upload.SimpleFileUploadActivity^maxFiles}</item>
        </echo>
        <action id="files" bean="class:com.aspectran.demo.examples.upload.SimpleFileUploadActivity" method="list"/>
        <dispatch name="templates/default"/>
    </translet>

</aspectran>
