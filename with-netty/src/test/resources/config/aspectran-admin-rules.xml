<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE aspectran PUBLIC "-//ASPECTRAN//DTD Aspectran 9.0//EN"
        "https://aspectran.com/dtd/aspectran-9.dtd">
<aspectran>

    <description>
        Test configuration for Netty Admin context.
    </description>

    <translet name="/dashboard">
        <echo>
            <item name="title">Admin Dashboard</item>
        </echo>
        <transform format="json"/>
    </translet>

    <translet name="/session">
        <action bean="adminSessionBean" method="process"/>
        <transform format="json"/>
    </translet>

    <bean id="adminSessionBean" class="com.aspectran.netty.server.TestSessionBean"/>

    <bean id="loggingGroupInspector" class="com.aspectran.netty.server.handler.logging.LoggingGroupInspector"/>

    <translet name="/logging-group">
        <action bean="loggingGroupInspector" method="getCurrentLoggingGroup"/>
        <transform format="text"/>
    </translet>

</aspectran>
